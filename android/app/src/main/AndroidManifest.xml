<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:name="android.software.leanback" android:required="true"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <application android:label="SG Sports" android:icon="@drawable/app_icon" android:roundIcon="@drawable/app_icon" android:banner="@drawable/banner" android:theme="@style/AppTheme" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security" android:usesCleartextTraffic="true">
  <activity android:name=".DesignActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".RecordingPlayerActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"/>
  <activity android:name=".PlayerActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"/>
 </application>
</manifest>
