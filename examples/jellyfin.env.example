# SG Sports -> Jellyfin DVR (optional; DVR is off unless SG_JELLYFIN_ENABLED=1). Placeholders only.
SG_JELLYFIN_ENABLED=1
SG_JELLYFIN_URL=https://jellyfin.example.com          # http:// only for loopback/private/container hosts
# Provide the API key ONE of two ways; never commit it:
#   SG_JELLYFIN_API_KEY=<set in the process environment, not in this file>
SG_JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key   # mode 600 (the service refuses group/other-readable files)
# SG Sports' own relay/export, reachable BY JELLYFIN (not by the TV):
SG_JELLYFIN_EXPORT_URL=http://sgsports.example.lan:8099
SG_JELLYFIN_RELAY_KEY_FILE=/run/secrets/jellyfin_relay_key  # random secret, mode 600; signs per-recording relay URLs
# Destructive retention is OFF. Enable only after the isolated gate passed and you approve it:
# SG_JELLYFIN_RETENTION_DELETE=1
